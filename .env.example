# ============================================================
# UniTrack environment configuration
# ------------------------------------------------------------
# Copy this file to `.env` in the project root and fill in the values
# from your Firebase project. The app reads these at build/start time.
#
# Where to get the values:
#   Firebase Console → Project settings → General → "Your apps"
#   → select the Web app (</>) → "SDK setup and configuration" → Config
#
# Security notes:
#   - EXPO_PUBLIC_* values are inlined into the app bundle and are NOT
#     secrets (a Firebase API key is a public project identifier).
#     Access control is enforced by firestore.rules / storage.rules and
#     Firebase Auth — never rely on the key for security.
#   - `.env` is git-ignored. Never commit real environment files.
#
# IMPORTANT: use the project that actually holds your data
# (the confirmed project is `unitrack-15d9`). If authDomain or
# storageBucket are omitted, they are derived from the project id as
# "<project-id>.firebaseapp.com" / "<project-id>.appspot.com".
# ============================================================

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
